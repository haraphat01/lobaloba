# Copy to .env.local (development) or set in your hosting provider (production).
# Never commit real values. Only NEXT_PUBLIC_* values are exposed to the browser.

# Public URL of the site (used in emails, payment callbacks, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack — Dashboard → Settings → API Keys & Webhooks (use sk_test_... until launch)
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Resend — transactional email (https://resend.com/api-keys). Verify your sending domain first.
RESEND_API_KEY=re_xxx
EMAIL_FROM="Lobaloba Deluxe <orders@lobalobadeluxe.com>"
# Fallback recipient for admin alerts (can also be set in Admin → Settings)
ADMIN_NOTIFICATION_EMAIL=
